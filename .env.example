# OPENAI_API_KEY: Official OpenAI API Key for powering Udit's AI chat completions.
# Required for OpenAI backend calls. Can be configured here or in user secrets.
OPENAI_API_KEY="your_openai_api_key_here"

# OPENAI_MODEL: Configurable OpenAI model (default: gpt-4o-mini, gpt-4o, etc.)
OPENAI_MODEL="gpt-4o-mini"

# GEMINI_API_KEY: Optional/alternative Google Gemini API key if switching engines.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

